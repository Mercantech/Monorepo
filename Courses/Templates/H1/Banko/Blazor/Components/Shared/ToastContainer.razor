@* Genbrugelig toast notifikation container *@
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
    @foreach (var toast in Toasts)
    {
        <div class="toast @(toast.Show ? "show" : "")" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header @(toast.IsSuccess ? "bg-success" : toast.IsError ? "bg-danger" : "bg-info") text-white">
                <strong class="me-auto">@toast.Title</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="@(() => OnDismiss.InvokeAsync(toast.Id))"></button>
            </div>
            <div class="toast-body">
                @toast.Message
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<ToastNotification> Toasts { get; set; } = new();
    [Parameter] public EventCallback<int> OnDismiss { get; set; }
}

