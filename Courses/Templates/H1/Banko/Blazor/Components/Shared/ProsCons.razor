@* Genbrugelig fordele/ulemper sektion *@
<div class="pros-cons">
    <div class="row">
        <div class="col-md-6">
            <h4>✅ Fordele:</h4>
            <ul>
                @foreach (var pro in Pros)
                {
                    <li>@((MarkupString)pro)</li>
                }
            </ul>
        </div>
        <div class="col-md-6">
            <h4>❌ Ulemper:</h4>
            <ul>
                @foreach (var con in Cons)
                {
                    <li>@((MarkupString)con)</li>
                }
            </ul>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<string> Pros { get; set; } = new();
    [Parameter] public List<string> Cons { get; set; } = new();
}

