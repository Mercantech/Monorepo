@* Komponent til at vise BankoPlate objekt i forskellige formater *@
@using Blazor.Services
@if (Plate == null)
{
    <p class="text-muted">Ingen plade data</p>
}
else
{
    <div>
        <h5>Datastruktur: BankoPlate klasse med 3 lister</h5>
        
        <div class="row mt-3">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <strong>Row0 (Række 1)</strong>
                    </div>
                    <div class="card-body">
                        @if (Plate.Row0 != null && Plate.Row0.Count > 0)
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var num in Plate.Row0)
                                {
                                    <li class="badge bg-primary me-1 mb-1" style="font-size: 1em;">@num</li>
                                }
                            </ul>
                            <p class="mt-2 mb-0"><small>Længde: @Plate.Row0.Count / 5</small></p>
                        }
                        else
                        {
                            <p class="text-muted">Ingen tal i række 0</p>
                        }
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <strong>Row1 (Række 2)</strong>
                    </div>
                    <div class="card-body">
                        @if (Plate.Row1 != null && Plate.Row1.Count > 0)
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var num in Plate.Row1)
                                {
                                    <li class="badge bg-success me-1 mb-1" style="font-size: 1em;">@num</li>
                                }
                            </ul>
                            <p class="mt-2 mb-0"><small>Længde: @Plate.Row1.Count / 5</small></p>
                        }
                        else
                        {
                            <p class="text-muted">Ingen tal i række 1</p>
                        }
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <strong>Row2 (Række 3)</strong>
                    </div>
                    <div class="card-body">
                        @if (Plate.Row2 != null && Plate.Row2.Count > 0)
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var num in Plate.Row2)
                                {
                                    <li class="badge bg-info me-1 mb-1" style="font-size: 1em;">@num</li>
                                }
                            </ul>
                            <p class="mt-2 mb-0"><small>Længde: @Plate.Row2.Count / 5</small></p>
                        }
                        else
                        {
                            <p class="text-muted">Ingen tal i række 2</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (ShowTable)
        {
            <div class="mt-4">
                <h5>Visualisering som Tabel (9 kolonner)</h5>
                <div class="table-responsive">
                    <BankoTable PlateData="@PlateGrid" />
                </div>
            </div>
        }

        @if (ShowJson)
        {
            <div class="mt-4">
                <h5>JSON Repræsentation</h5>
                <CodeBlock Language="json">@JsonString</CodeBlock>
            </div>
        }
    </div>
}

@code {
    [Parameter] public BankoPlate? Plate { get; set; }
    [Parameter] public bool ShowTable { get; set; } = true;
    [Parameter] public bool ShowJson { get; set; } = false;
    [Parameter] public int[,]? PlateGrid { get; set; }
    
    private string JsonString => Plate != null 
        ? System.Text.Json.JsonSerializer.Serialize(Plate, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })
        : "";
}

