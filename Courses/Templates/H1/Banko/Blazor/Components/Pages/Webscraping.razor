                <h3 class="mt-4">Best Practices</h3>
                <ExampleBox>
                    <ol>
                        <li><strong>Læs robots.txt:</strong> Tjek altid om scraping er tilladt</li>
                        <li><strong>Rate Limiting:</strong> Vent 1-2 sekunder mellem requests</li>
                        <li><strong>User-Agent:</strong> Identificer dit script korrekt</li>
                        <li><strong>Fejlhåndtering:</strong> Håndter fejl gracefully uden at crashe serveren</li>
                        <li><strong>Caching:</strong> Undgå at hente samme data flere gange</li>
                        <li><strong>Kontakt ejeren:</strong> Spørg først om tilladelse for store projekter</li>
                    </ol>
                </ExampleBox>

                <h3 class="mt-4">Eksempel: Respektfuld Scraping</h3>
                <CodeBlock Language="csharp">
using System;
using System.Threading.Tasks;
using HtmlAgilityPack;
using System.Net.Http;

public class EthicalWebScraper
{
    private readonly HttpClient _httpClient;
    
    public EthicalWebScraper()
    {
        _httpClient = new HttpClient();
        // Identificer dig selv korrekt
        _httpClient.DefaultRequestHeaders.Add(
            "User-Agent", 
            "BankoCheater/1.0 (Educational Purpose)"
        );
    }
    
    public async Task&lt;string&gt; ScrapeWithDelay(string url)
    {
        // Tjek først robots.txt (skal implementeres separat)
        
        // Hent data
        var html = await _httpClient.GetStringAsync(url);
        
        // Vent først næste request (rate limiting)
        await Task.Delay(2000); // 2 sekunder
        
        return html;
    }
}
