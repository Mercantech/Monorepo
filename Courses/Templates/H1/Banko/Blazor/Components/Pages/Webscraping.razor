            <!-- Læringsmål 3: DOM Analyse -->
            <section class="mb-5">
                <h2>3. Analysere en DOM med Henblik på Scraping</h2>
                
                <p>
                    <strong>DOM</strong> (Document Object Model) er den strukturerede repræsentation af en HTML-side. 
                    For at scrape data effektivt, skal man først forstå sidenes struktur.
                </p>

                <h3 class="mt-4">Sådan Analyserer du en DOM</h3>
                
                <div class="step-by-step">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5>Trin 1: Inspect Element</h5>
                            <p>
                                Brug browserens developer tools (F12) til at inspektere elementerne på siden. 
                                Find det element, der indeholder den data, du ønsker at hente.
                            </p>
                            <ul>
                                <li>Højreklik på elementet → "Inspect"</li>
                                <li>Eller tryk F12 → vælg "Elements" tab</li>
                                <li>Se HTML strukturen og find unikke attributter</li>
                            </ul>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body">
                            <h5>Trin 2: Identificer Selektorer</h5>
                            <p>
                                Find CSS selektorer eller XPath, der kan identificere det ønskede element unikt:
                            </p>
                            <ul>
                                <li><strong>ID:</strong> <code>#unique-id</code></li>
                                <li><strong>Class:</strong> <code>.class-name</code></li>
                                <li><strong>Tag + Class:</strong> <code>div.content</code></li>
                                <li><strong>XPath:</strong> <code>//div[@@class='content']</code></li>
                                <li><strong>Attribute:</strong> <code>[data-testid='element']</code></li>
                            </ul>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body">
                            <h5>Trin 3: Test Selektoren</h5>
                            <p>
                                Verificer at selektoren virker ved at teste den i browser console:
                            </p>
                            <CodeBlock Language="javascript">
// I browser console:
document.querySelector('#unique-id');
document.querySelectorAll('.class-name');
// Eller med XPath:
document.evaluate('//div[@@class="content"]', document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;
                            </CodeBlock>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body">
                            <h5>Trin 4: Implementer i Kode</h5>
                            <p>
                                Brug selektoren i dit scraping script med HtmlAgilityPack eller lignende:
                            </p>
                        </div>
                    </div>
                </div>

                <h3 class="mt-4">Eksempel: DOM Analyse og Scraping</h3>
                
                <div class="alert alert-info" role="alert">
                    <strong>Eksempel:</strong> Lad os sige vi vil scrape alle priser fra en produktliste
                </div>

                <ExampleBox>
                    <h5>HTML Struktur:</h5>
                    <CodeBlock Language="html">
&lt;div class="products"&gt;
    &lt;div class="product" data-id="1"&gt;
        &lt;h3&gt;Produkt 1&lt;/h3&gt;
        &lt;span class="price"&gt;299 kr&lt;/span&gt;
    &lt;/div&gt;
    &lt;div class="product" data-id="2"&gt;
        &lt;h3&gt;Produkt 2&lt;/h3&gt;
        &lt;span class="price"&gt;499 kr&lt;/span&gt;
    &lt;/div&gt;
&lt;/div&gt;
                    </CodeBlock>
                </ExampleBox>

                <h5 class="mt-3">C# Kode til at Scrape Priserne:</h5>
                <CodeBlock Language="csharp">
using HtmlAgilityPack;
using System.Collections.Generic;
using System.Linq;

public class PriceScraper
{
    public List&lt;string&gt; ScrapePrices(string html)
    {
        var doc = new HtmlDocument();
        doc.LoadHtml(html);
        
        // Find alle produkt-divs
        var productNodes = doc.DocumentNode
            .SelectNodes("//div[@@class='product']");
        
        var prices = new List&lt;string&gt;();
        
        foreach (var product in productNodes)
        {
            // Find prisen i hvert produkt
            var priceNode = product.SelectSingleNode(".//span[@@class='price']");
            if (priceNode != null)
            {
                prices.Add(priceNode.InnerText.Trim());
            }
        }
        
        return prices;
    }
}
                </CodeBlock>

