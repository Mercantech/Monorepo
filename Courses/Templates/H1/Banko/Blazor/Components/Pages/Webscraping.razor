            <!-- Læringsmål 1: Begreb og værktøjer -->
            <section class="mb-5">
                <h2>1. Hvad er Webscraping?</h2>
                
                <p>
                    <strong>Webscraping</strong> (også kaldt web harvesting eller web data extraction) er en proces, 
                    hvor man automatisk henter data fra websites ved hjælp af software. I stedet for manuelt at kopiere 
                    data fra en hjemmeside, kan man lade et program gøre det automatisk.
                </p>

                <h3 class="mt-4">Hvorfor bruge Webscraping?</h3>
                <ul>
                    <li>Automation af datahentning fra websites</li>
                    <li>Overvågning af prisændringer</li>
                    <li>Samling af forskningsdata</li>
                    <li>Aggregering af nyheder fra flere kilder</li>
                    <li>Markedsanalyse og konkurrentovervågning</li>
                </ul>

                <h3 class="mt-4">Populære Værktøjer til Webscraping</h3>
                
                <div class="row mt-3">
                    <div class="col-md-6 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">Python Værktøjer</h5>
                                <ul class="list-unstyled">
                                    <li><strong>Beautiful Soup:</strong> Nem parsing af HTML/XML</li>
                                    <li><strong>Scrapy:</strong> Komplet webscraping framework</li>
                                    <li><strong>Selenium:</strong> Automatisering af browsere</li>
                                    <li><strong>Requests:</strong> HTTP bibliotek til at hente sider</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">C#/.NET Værktøjer</h5>
                                <ul class="list-unstyled">
                                    <li><strong>HtmlAgilityPack:</strong> HTML parsing bibliotek</li>
                                    <li><strong>AngleSharp:</strong> Modern HTML parser</li>
                                    <li><strong>PuppeteerSharp:</strong> Browser automatisering</li>
                                    <li><strong>HttpClient:</strong> HTTP requests til at hente sider</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <h3 class="mt-4">Eksempel: Simple Webscraping med C#</h3>
                <CodeBlock Language="csharp">
using HtmlAgilityPack;
using System.Net.Http;

public class WebScraper
{
    public async Task&lt;string&gt; ScrapeTitle(string url)
    {
        // Hent HTML fra URL
        var httpClient = new HttpClient();
        var html = await httpClient.GetStringAsync(url);
        
        // Parse HTML
        var doc = new HtmlDocument();
        doc.LoadHtml(html);
        
        // Find titel
        var titleNode = doc.DocumentNode.SelectSingleNode("//title");
        return titleNode?.InnerText ?? "Ingen titel fundet";
    }
}
                </CodeBlock>
