@page "/enterprice/adusers"
@using Enterprice
@using Blazor.Services
@inject ADServiceWrapper ADService

<div class="game-hero text-center py-5 mb-4">
    <h1 class="display-4 fw-bold mb-3">Brugeroversigt (Active Directory)</h1>
    <p class="lead mb-0">Få et overblik over alle brugere i jeres AD – og lær om brugeradministration!</p>
</div>

<div class="container game-content">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (isLoading)
            {
                <div class="card shadow-lg mb-5 border-0 game-card">
                    <div class="card-body p-5">
                        <div class="text-center py-3">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Henter brugere...</span>
                            </div>
                            <p class="mt-3 mb-2"><strong>Henter brugere fra Active Directory...</strong></p>
                            @if (!string.IsNullOrEmpty(statusMessage))
                            {
                                <div class="alert alert-info mt-3 mb-0">
                                    <small>@statusMessage</small>
                                </div>
                            }
                            @if (users != null && users.Any())
                            {
                                <div class="mt-3">
                                    <p class="text-muted mb-2">Indtil videre hentet: <strong>@users.Count brugere</strong></p>
                                    <div class="progress" style="height: 25px;">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                             role="progressbar" 
                                             style="width: 100%">
                                            Henter flere brugere...
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else if (errorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    <strong>Fejl:</strong> @errorMessage
                </div>
            }
            else if (users != null && users.Any())
            {
                <div class="card shadow-lg mb-5 border-0 game-card">
                    <div class="card-header bg-primary text-white">
                        <h2 class="h4 mb-0">AD Brugere (@users.Count)</h2>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Navn</th>
                                        <th>Email</th>
                                        <th>Afdeling</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in users)
                                    {
                                        <tr>
                                            <td><strong>@user.Name</strong></td>
                                            <td>@user.Email</td>
                                            <td>@user.Department</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-lg mb-5 border-0 game-card">
                    <div class="card-body p-5">
                        <div class="alert alert-info">
                            <strong>Ingen brugere fundet.</strong> Implementer hentning af brugere i UserADService.GetAllUsers() for at se brugere her.
                        </div>
                        <h2 class="h4 mb-3 text-primary fw-semibold">Sådan gør du:</h2>
                        <ul class="list-group list-group-flush mb-4">
                            <li class="list-group-item">Forbind til jeres AD og hent alle brugere.</li>
                            <li class="list-group-item">Vis brugerne i en oversigt – fx som en tabel eller liste.</li>
                            <li class="list-group-item"><em>Ekstra:</em> Vis detaljer om hver bruger, fx navn, mail og gruppe.</li>
                        </ul>
                        <div class="alert alert-info mt-4">
                            <strong>Tip:</strong> Prøv at udvide med søgning eller filtrering af brugere!
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<global::Enterprice.ADUser>? users;
    private bool isLoading = true;
    private string? errorMessage;
    private string statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Lad siden loade først
        await Task.Delay(100);
        
        try
        {
            isLoading = true;
            users = new List<global::Enterprice.ADUser>();
            
            // Hent data asynkront med progress updates
            users = await ADService.GetAllUsersAsync((message) =>
            {
                statusMessage = message;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            statusMessage = string.Empty;
        }
    }
}

<style>
.game-hero {
    background: linear-gradient(90deg, #1b6ec2 0%, #3a0647 100%);
    color: #fff;
    border-radius: 0 0 2rem 2rem;
    box-shadow: 0 4px 32px rgba(27,110,194,0.10);
}
.game-content {
    margin-top: -40px;
}
.game-card {
    border-radius: 1.5rem;
}
</style>
