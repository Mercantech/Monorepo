}

// Konkret implementering
public class StandardPlate : BankoPlate
{
    public override bool ValidatePlate()
    {
        // Valider at hver række har præcis 5 tal
        return Row0.Count == 5 && Row1.Count == 5 && Row2.Count == 5;
    }
}";

