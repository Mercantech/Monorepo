    private string abstractionExample = @"// Abstrakt klasse - kan ikke instantieres direkte
public abstract class BankoPlate
{
    public string Id { get; set; }
    public List<int> Row0 { get; protected set; }
    public List<int> Row1 { get; protected set; }
    public List<int> Row2 { get; protected set; }
    
    // Abstrakt metode - skal implementeres i underklasser
    public abstract bool ValidatePlate();
    
    // Konkret metode - deles af alle underklasser
