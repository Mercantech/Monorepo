    private string encapsulationExample = @"public class BankoPlate
{
    // Private lister - kan ikke ændres udefra
    private List<int> row0;
    private List<int> row1;
    private List<int> row2;
    
    // Public properties - læsbare, men ikke skrivbare udefra
    public List<int> Row0 
    { 
        get { return row0; }  // Læsbar, men ikke skrivbar udefra
    }
    
    // Kun gennem metoder kan vi ændre data
    public void AddNumber(int row, int value)
    {
        // Validering først!
        if (IsValidValue(value) && row >= 0 && row < 3)
        {
            List<int> rowList = row == 0 ? row0 : row == 1 ? row1 : row2;
            if (!rowList.Contains(value) && rowList.Count < 5)
            {
                rowList.Add(value);
            }
        }
    }
}";

    private string inheritanceExample = @"// Basisklasse
public class BankoPlate
{
    public string Id { get; set; }
    public List<int> Row0 { get; protected set; }
    public List<int> Row1 { get; protected set; }
    public List<int> Row2 { get; protected set; }
    
    public virtual void ShowPlate()
    {
        Console.WriteLine(""Plate ID: "" + Id);
        Console.WriteLine(""Row 0: "" + string.Join("", "", Row0));
    }
}

// Afledt klasse - arver fra BankoPlate
public class GamePlate : BankoPlate
{
    public bool IsActive { get; set; }
    
    public GamePlate(string id) : base(id)
    {
        IsActive = true;
    }
    
    // Overskriv (override) metoden fra basisklassen
    public override void ShowPlate()
    {
        base.ShowPlate();
        Console.WriteLine(""Status: "" + (IsActive ? ""Active"" : ""Inactive""));
    }
}";

    private string polymorphismExample = @"// Fælles interface
