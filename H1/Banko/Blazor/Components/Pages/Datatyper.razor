    private string dictionaryIntroCode = "Dictionary<string, int[,]> plates = new();";

    private string bankoPlateClassExample = @"public class BankoPlate
{
    // Egenskaber (Properties) - 3 lister, én for hver række
    public string Id { get; set; }
    public List<int> Row0 { get; private set; }
    public List<int> Row1 { get; private set; }
    public List<int> Row2 { get; private set; }
    public DateTime Created { get; private set; }

    // Konstruktør
    public BankoPlate(string id)
    {
        Id = id;
        Row0 = new List<int>();
        Row1 = new List<int>();
        Row2 = new List<int>();
        Created = DateTime.Now;
    }

    // Metode til at tilføje et tal til en række
    public void AddNumber(int row, int number)
    {
        if (row >= 0 && row < 3)
        {
            List<int> rowList = row == 0 ? Row0 : row == 1 ? Row1 : Row2;
            if (!rowList.Contains(number) && rowList.Count < 5)
            {
                rowList.Add(number);
                rowList.Sort(); // Sorter talene
            }
        }
    }

    // Metode til at tjekke om et tal er på pladen
    public bool HasNumber(int number)
    {
        return Row0.Contains(number) || Row1.Contains(number) || Row2.Contains(number);
    }

    // Metode til at tjekke om en række er fuld
    public bool IsRowFull(int row)
    {
        List<int> rowList = row == 0 ? Row0 : row == 1 ? Row1 : Row2;
        return rowList.Count == 5; // En række har præcis 5 tal
    }

    // Metode til at markere et tal som trukket
    public void MarkNumberDrawn(int number)
    {
        if (Row0.Contains(number))
            Row0.Remove(number);
        if (Row1.Contains(number))
            Row1.Remove(number);
        if (Row2.Contains(number))
            Row2.Remove(number);
    }
}

// Brug af klassen
BankoPlate myPlate = new BankoPlate(""Banko"");
myPlate.AddNumber(0, 4);
myPlate.AddNumber(0, 21);
myPlate.AddNumber(0, 31);
myPlate.AddNumber(0, 52);
myPlate.AddNumber(0, 71);

if (myPlate.HasNumber(4))
{
    Console.WriteLine(""Pladen har tallet 4!"");
}

if (myPlate.IsRowFull(0))
{
    Console.WriteLine(""Række 0 er fuld!"");
}";

