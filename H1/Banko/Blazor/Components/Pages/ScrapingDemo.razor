@page "/scraping-demo"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject Blazor.Services.BankoScrapingService ScrapingService
@using System.Text.Json
@using Blazor.Services

<PageTitle>Scraping Demo</PageTitle>

<div class="container mt-4">
    <h1 class="display-4 mb-4">Demo: Scrape Bankoplader</h1>
    
    <div class="row">
        <div class="col-lg-10">
            <section class="mb-5">
                <p class="lead">
                    Denne demo viser hvordan man scraper en bankoplade fra 
                    <a href="https://mercantech.github.io/Banko/" target="_blank">https://mercantech.github.io/Banko/</a>
                    og viser den i det anbefalede format med en klasse der indeholder 3 lister af længde 5.
                </p>
            </section>

            <!-- Toast Container -->
            <ToastContainer Toasts="@toasts" OnDismiss="DismissToast" />

            <div class="card mb-4">
                <div class="card-body">
                    <h3>Test Scraping</h3>
                    <div class="mb-3">
                        <label for="plateId" class="form-label">Indtast ID/Navn for plade:</label>
                        <div class="input-group">
                            <input type="text" 
                                   class="form-control" 
                                   id="plateId" 
                                   value="@plateId"
                                   @oninput="HandleInput"
                                   placeholder="f.eks. 'Banko' eller 'Test123'"
                                   @onkeydown="HandleKeyDown" />
                            <button class="btn btn-primary" @onclick="HandleScrapeClick" disabled="@(isScraping || string.IsNullOrWhiteSpace(plateId))">
                                @if (isScraping)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <text>Scraper...</text>
                                }
                                else
                                {
                                    <text>Scrape Plade</text>
                                }
                            </button>
                        </div>
                        <small class="form-text text-muted">
                            Hvert unikt navn/ID giver en unik plade. Tryk Enter eller klik på knappen.
                            @if (!string.IsNullOrWhiteSpace(plateId))
                            {
                                <span class="text-success">(ID indtastet: "@plateId")</span>
                            }
                        </small>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>Fejl:</strong> @errorMessage
                        </div>
                    }

                    @if (scrapedPlate != null)
                    {
                        <div class="alert alert-success" role="alert">
                            <strong>Succes!</strong> Pladen med ID "@scrapedPlate.Id" er blevet scraped.
                        </div>
                    }

                    <ProgressLog Messages="@progressMessages" Title="Scraping Status:" />
                </div>
            </div>

            @if (scrapedPlate != null)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h4>Scraped Plade: @scrapedPlate.Id</h4>
                    </div>
                    <div class="card-body">
                        <BankoPlateDisplay Plate="@scrapedPlate" 
                                           ShowTable="true" 
                                           ShowJson="true" 
                                           PlateGrid="@plateGrid" />
                    </div>
                </div>
            }

            <div class="card mb-4">
                <div class="card-header">
                    <h4>Kode Eksempel: BankoPlate Klasse</h4>
                </div>
                <div class="card-body">
                    <CodeBlock Language="csharp">
public class BankoPlate
{
    public string Id { get; set; } = string.Empty;
    public List&lt;int&gt; Row0 { get; set; } = new List&lt;int&gt;();
    public List&lt;int&gt; Row1 { get; set; } = new List&lt;int&gt;();
    public List&lt;int&gt; Row2 { get; set; } = new List&lt;int&gt;();
    
    public BankoPlate(string id)
    {
        Id = id;
        Row0 = new List&lt;int&gt;();
        Row1 = new List&lt;int&gt;();
        Row2 = new List&lt;int&gt;();
    }
}
                    </CodeBlock>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string plateId = string.Empty;
    private BankoPlate? scrapedPlate;
    private bool isScraping = false;
    private string errorMessage = string.Empty;
    private int[,] plateGrid = new int[3, 9];
    private List<ProgressMessage> progressMessages = new List<ProgressMessage>();
    private List<ToastNotification> toasts = new List<ToastNotification>();
    private int toastIdCounter = 0;

    private void HandleInput(ChangeEventArgs e)
    {
        plateId = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(plateId) && !isScraping)
        {
            await ScrapePlate();
        }
    }

    private async Task HandleScrapeClick()
    {
        await ScrapePlate();
    }

    private async Task ScrapePlate()
    {
        if (string.IsNullOrWhiteSpace(plateId))
        {
            return;
        }

        isScraping = true;
        errorMessage = string.Empty;
        scrapedPlate = null;
        StateHasChanged();

        try
        {
            // Nulstil progress messages
            progressMessages.Clear();
            
            // Scrape fra den rigtige hjemmeside med Selenium
            scrapedPlate = await ScrapingService.ScrapePlateAsync(plateId, OnProgressUpdate);
            
            // Konverter til grid format for visualisering
            ConvertToGrid(scrapedPlate);
            
            // Vis succes toast
            ShowToast("Succes!", $"Pladen med ID '{plateId}' er blevet scraped med {scrapedPlate.Row0.Count + scrapedPlate.Row1.Count + scrapedPlate.Row2.Count} tal!", true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Fejl under scraping: {ex.Message}";
            ShowToast("Fejl", $"Der opstod en fejl: {ex.Message}", true, true);
        }
        finally
        {
            isScraping = false;
            StateHasChanged();
        }
    }


    private void ConvertToGrid(BankoPlate plate)
    {
        // Nulstil grid
        plateGrid = new int[3, 9];

        // Række 0
        foreach (var num in plate.Row0)
        {
            int col = GetColumnForNumber(num);
            if (col >= 0 && col < 9)
            {
                plateGrid[0, col] = num;
            }
        }

        // Række 1
        foreach (var num in plate.Row1)
        {
            int col = GetColumnForNumber(num);
            if (col >= 0 && col < 9)
            {
                plateGrid[1, col] = num;
            }
        }

        // Række 2
        foreach (var num in plate.Row2)
        {
            int col = GetColumnForNumber(num);
            if (col >= 0 && col < 9)
            {
                plateGrid[2, col] = num;
            }
        }
    }

    private int GetColumnForNumber(int number)
    {
        if (number >= 1 && number <= 9) return 0;
        if (number >= 10 && number <= 19) return 1;
        if (number >= 20 && number <= 29) return 2;
        if (number >= 30 && number <= 39) return 3;
        if (number >= 40 && number <= 49) return 4;
        if (number >= 50 && number <= 59) return 5;
        if (number >= 60 && number <= 69) return 6;
        if (number >= 70 && number <= 79) return 7;
        if (number >= 80 && number <= 90) return 8;
        return -1;
    }

    private string GetCellValue(int row, int col)
    {
        int value = plateGrid[row, col];
        return value > 0 ? value.ToString() : "";
    }

    private void OnProgressUpdate(string message)
    {
        // Tilføj til progress messages
        progressMessages.Add(new ProgressMessage 
        { 
            Message = message, 
            Timestamp = DateTime.Now 
        });
        
        // Vis toast notifikation
        ShowToast("Status", message, false);
        
        // Trigger UI update
        StateHasChanged();
    }

    private void ShowToast(string title, string message, bool isSuccess = false, bool isError = false)
    {
        var toast = new ToastNotification
        {
            Id = toastIdCounter++,
            Title = title,
            Message = message,
            Show = true,
            IsSuccess = isSuccess,
            IsError = isError
        };
        
        toasts.Add(toast);
        StateHasChanged();
        
        // Auto-fjern efter 5 sekunder hvis det ikke er en succes/fejl
        if (!isSuccess && !isError)
        {
            Task.Delay(5000).ContinueWith(_ =>
            {
                InvokeAsync(() =>
                {
                    DismissToast(toast.Id);
                });
            });
        }
        else if (isSuccess || isError)
        {
            // Auto-fjern succes/fejl efter 7 sekunder
            Task.Delay(7000).ContinueWith(_ =>
            {
                InvokeAsync(() =>
                {
                    DismissToast(toast.Id);
                });
            });
        }
    }

    private async Task DismissToast(int id)
    {
        var toast = toasts.FirstOrDefault(t => t.Id == id);
        if (toast != null)
        {
            toast.Show = false;
            StateHasChanged();
            
            // Fjern efter animation
            await Task.Delay(300);
            toasts.RemoveAll(t => t.Id == id);
            StateHasChanged();
        }
    }
}


