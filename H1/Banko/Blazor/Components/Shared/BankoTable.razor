@* Komponent til at vise en bankoplade som tabel (3 rækker x 9 kolonner) *@
<table class="banko-table">
    <thead>
        <tr>
            <th>1-9</th>
            <th>10-19</th>
            <th>20-29</th>
            <th>30-39</th>
            <th>40-49</th>
            <th>50-59</th>
            <th>60-69</th>
            <th>70-79</th>
            <th>80-90</th>
        </tr>
    </thead>
    <tbody>
        @for (int row = 0; row < 3; row++)
        {
            <tr>
                @for (int col = 0; col < 9; col++)
                {
                    <td class="@(GetCellValue(row, col) == "" ? "empty" : "")">
                        @GetCellValue(row, col)
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public int[,]? PlateData { get; set; }
    
    private string GetCellValue(int row, int col)
    {
        if (PlateData == null) return "";
        int value = PlateData[row, col];
        return value > 0 ? value.ToString() : "";
    }
}

