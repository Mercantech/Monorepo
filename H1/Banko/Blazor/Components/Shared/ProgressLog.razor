@* Genbrugelig progress log komponent *@
@if (Messages.Count > 0)
{
    <div class="mt-3">
        <h6>@Title</h6>
        <div class="list-group" style="max-height: @(MaxHeight)px; overflow-y: auto;">
            @foreach (var msg in Messages)
            {
                <div class="list-group-item list-group-item-action">
                    <small class="text-muted">@msg.Timestamp.ToString("HH:mm:ss")</small>
                    <div>@msg.Message</div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public List<ProgressMessage> Messages { get; set; } = new();
    [Parameter] public string Title { get; set; } = "Status Log";
    [Parameter] public int MaxHeight { get; set; } = 300;
}

