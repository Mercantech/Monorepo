@page "/to-stjerner/admin"
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject ITwoStarsWishBoard FeedbackBoard

<PageTitle>To stjerner – Admin</PageTitle>

<div class="admin-wrapper">
    <header class="admin-header mb-4">
        <h1 class="display-6">
            <i class="fas fa-star-half-stroke me-3 text-primary"></i>
            To stjerner & et ønske · Admin
        </h1>
        <p class="text-muted mb-0">
            Opsæt dagens tema og få overblik over alle indsendte stjerner og ønsker i realtid.
            Del ikke dette link med eleverne.
        </p>
    </header>

    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <EditForm Model="_themeInput" OnValidSubmit="HandleThemeSubmit">
                <DataAnnotationsValidator />

                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label" for="themeTitle">Aktivt tema</label>
                        <InputText id="themeTitle"
                                   @bind-Value="_themeInput.ThemeTitle"
                                   class="form-control form-control-lg"
                                   placeholder="Fx Sprint-evaluering, CL-workshop..." />
                        <ValidationMessage For="() => _themeInput.ThemeTitle" />
                    </div>

                    <div class="col-md-3">
                        <div class="form-check mt-3 mt-md-0">
                            <InputCheckbox id="resetEntries"
                                           class="form-check-input"
                                           @bind-Value="_themeInput.ResetPrevious" />
                            <label class="form-check-label fw-semibold" for="resetEntries">
                                Start med tom væg
                            </label>
                            <div class="form-text">
                                Rydder alle tidligere indsendelser.
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1" disabled="@_isSavingTheme">
                            <i class="fas fa-rocket-launch me-2"></i>Aktivér tema
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="ResetForm"
                                disabled="@_isSavingTheme">
                            Nulstil
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_themeSuccess))
                {
                    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                        <i class="fas fa-circle-check me-2"></i>@_themeSuccess
                        <button type="button" class="btn-close" @onclick="() => _themeSuccess = null"></button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_themeError))
                {
                    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                        <i class="fas fa-circle-exclamation me-2"></i>@_themeError
                        <button type="button" class="btn-close" @onclick="() => _themeError = null"></button>
                    </div>
                }
            </EditForm>
        </div>
    </section>

    <section class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">Indsendte stjerner og ønsker</h2>
                    <p class="text-muted mb-0">
                        @(_entries.Count) bidrag · @(!string.IsNullOrWhiteSpace(_currentTheme) ? $"Tema: {_currentTheme}" : "Intet aktivt tema")
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-danger"
                            @onclick="ConfirmClearEntries"
                            disabled="@(_entries.Count == 0)">
                        <i class="fas fa-trash-can me-2"></i>Ryd alle bidrag
                    </button>
                </div>
            </div>

            @if (_entries.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-inbox-open fa-2x mb-3"></i>
                    <p class="mb-0">Ingen indsendelser endnu. Bed eleverne om at dele deres stjerner og ønsker.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                        <tr>
                            <th>Tidspunkt</th>
                            <th>Stjerne 1</th>
                            <th>Stjerne 2</th>
                            <th>Ønske</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var entry in _entries)
                        {
                            <tr>
                                <td class="text-nowrap text-muted">@entry.CreatedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@entry.StarOne</td>
                                <td>@entry.StarTwo</td>
                                <td>@entry.Wish</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    @if (_showClearDialog)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="fas fa-triangle-exclamation me-2 text-danger"></i>Bekræft rydning</h5>
                        <button type="button" class="btn-close" @onclick="CancelClear"></button>
                    </div>
                    <div class="modal-body">
                        <p>Er du sikker på, at du vil slette alle indsendte stjerner og ønsker? Denne handling kan ikke fortrydes.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelClear">Fortryd</button>
                        <button type="button" class="btn btn-danger" @onclick="ClearEntriesConfirmed">
                            Slet alle bidrag
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly AdminThemeInput _themeInput = new();
    private IReadOnlyList<TwoStarsWishEntry> _entries = Array.Empty<TwoStarsWishEntry>();
    private string? _currentTheme;

    private bool _isSavingTheme;
    private bool _showClearDialog;

    private string? _themeSuccess;
    private string? _themeError;

    protected override void OnInitialized()
    {
        _currentTheme = FeedbackBoard.CurrentTheme;
        _themeInput.ThemeTitle = _currentTheme ?? string.Empty;
        _entries = FeedbackBoard.GetEntriesSnapshot();
        FeedbackBoard.EntriesChanged += HandleEntriesChanged;
    }

    private void HandleEntriesChanged()
    {
        InvokeAsync(() =>
        {
            _currentTheme = FeedbackBoard.CurrentTheme;
            _entries = FeedbackBoard.GetEntriesSnapshot();
            StateHasChanged();
        });
    }

    private async Task HandleThemeSubmit()
    {
        _isSavingTheme = true;
        _themeSuccess = null;
        _themeError = null;

        try
        {
            FeedbackBoard.SetCurrentTheme(_themeInput.ThemeTitle, _themeInput.ResetPrevious);
            _themeSuccess = "Temaet er opdateret og klar til eleverne.";
            _themeInput.ResetPrevious = false;
        }
        catch (Exception ex)
        {
            _themeError = ex.Message;
        }
        finally
        {
            _isSavingTheme = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ResetForm()
    {
        _themeInput.ThemeTitle = FeedbackBoard.CurrentTheme ?? string.Empty;
        _themeInput.ResetPrevious = false;
    }

    private void ConfirmClearEntries()
    {
        _showClearDialog = true;
    }

    private void CancelClear()
    {
        _showClearDialog = false;
    }

    private void ClearEntriesConfirmed()
    {
        FeedbackBoard.Clear();
        _showClearDialog = false;
    }

    public void Dispose()
    {
        FeedbackBoard.EntriesChanged -= HandleEntriesChanged;
    }

    private sealed class AdminThemeInput
    {
        [Display(Name = "Tema")]
        [Required(ErrorMessage = "Skriv et tema, som eleverne skal forholde sig til.")]
        [StringLength(120, ErrorMessage = "Temaet må højst være på 120 tegn.")]
        public string ThemeTitle { get; set; } = string.Empty;

        public bool ResetPrevious { get; set; }
    }
}

