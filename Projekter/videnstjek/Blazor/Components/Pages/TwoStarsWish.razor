@page "/to-stjerner"
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject ITwoStarsWishBoard FeedbackBoard

<PageTitle>To stjerner og et ønske</PageTitle>

<div class="two-stars-page">
    <header class="page-header">
        <h1><i class="fas fa-star me-2 text-warning"></i>To stjerner og et ønske</h1>
        @if (string.IsNullOrWhiteSpace(_currentTheme))
        {
            <p class="lead text-muted">
                Læreren har endnu ikke aktiveret et tema. Vent et øjeblik og prøv igen.
            </p>
        }
        else
        {
            <div class="theme-banner card bg-light border-0 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-primary-subtle text-primary fw-semibold text-uppercase mb-2">
                        Dagens fokus
                    </span>
                    <h2 class="h4 mb-0">@_currentTheme</h2>
                </div>
            </div>
            <p class="lead mt-3">
                Del dine højdepunkter og ønsker fra dagens læring – helt anonymt. Når du trykker <strong>Del feedback</strong>,
                sendes din feedback til underviseren.
            </p>
        }
    </header>

    <section class="feedback-form card shadow-sm">
        <div class="card-body">
            <EditForm Model="_input" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-4">
                    <div class="col-md-4">
                        <label class="form-label" for="starOne">Stjerne 1</label>
                        <InputTextArea id="starOne"
                                       @bind-Value="_input.StarOne"
                                       class="form-control form-control-lg"
                                       placeholder="Hvad fungerede særligt godt?"
                                       rows="4" />
                        <ValidationMessage For="() => _input.StarOne" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="starTwo">Stjerne 2</label>
                        <InputTextArea id="starTwo"
                                       @bind-Value="_input.StarTwo"
                                       class="form-control form-control-lg"
                                       placeholder="Hvad løftede din læring eller fællesskabet?"
                                       rows="4" />
                        <ValidationMessage For="() => _input.StarTwo" />
                    </div>
                </div>

                <div class="row g-4 mt-1">
                    <div class="col">
                        <label class="form-label" for="wish">Ønske</label>
                        <InputTextArea id="wish"
                                       @bind-Value="_input.Wish"
                                       class="form-control form-control-lg"
                                       placeholder="Hvad kunne gøre næste forløb endnu bedre?"
                                       rows="4" />
                        <ValidationMessage For="() => _input.Wish" />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 mt-4">
                    <button type="submit"
                            class="btn btn-primary btn-lg px-4"
                            disabled="@(_isSaving || string.IsNullOrWhiteSpace(_currentTheme))">
                        <i class="fas fa-paper-plane me-2"></i>Del feedback
                    </button>
                    <small class="text-muted">
                        Alle svar er anonyme og deles kun med underviseren.
                        @if (string.IsNullOrWhiteSpace(_currentTheme))
                        {
                            <span class="ms-1 text-danger">Vent til temaet er aktivt.</span>
                        }
                    </small>
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@_successMessage
                    <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
                    <i class="fas fa-triangle-exclamation me-2"></i>@_errorMessage
                    <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                </div>
            }
        </div>
    </section>

</div>

@code {
    private FeedbackInput _input = new();
    private string? _currentTheme;

    private bool _isSaving;
    private string? _successMessage;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        _currentTheme = FeedbackBoard.CurrentTheme;
        FeedbackBoard.EntriesChanged += HandleEntriesChanged;
    }

    private Task HandleValidSubmit()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            FeedbackBoard.AddEntry(_input.StarOne, _input.StarTwo, _input.Wish, null);
            _successMessage = "Tak for dine stjerner og dit ønske! Din underviser kan nu se dem.";
            _input = new FeedbackInput();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void HandleEntriesChanged()
    {
        InvokeAsync(() =>
        {
            _currentTheme = FeedbackBoard.CurrentTheme;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        FeedbackBoard.EntriesChanged -= HandleEntriesChanged;
    }

    private sealed class FeedbackInput
    {
        [Display(Name = "Stjerne 1")]
        [Required(ErrorMessage = "Skriv mindst én ting, der fungerede godt.")]
        [StringLength(400, ErrorMessage = "Din stjerne må højst være på 400 tegn.")]
        public string StarOne { get; set; } = string.Empty;

        [Display(Name = "Stjerne 2")]
        [Required(ErrorMessage = "Skriv også en anden styrke fra forløbet.")]
        [StringLength(400, ErrorMessage = "Din stjerne må højst være på 400 tegn.")]
        public string StarTwo { get; set; } = string.Empty;

        [Display(Name = "Ønske")]
        [Required(ErrorMessage = "Del gerne, hvad der kan blive endnu bedre.")]
        [StringLength(400, ErrorMessage = "Dit ønske må højst være på 400 tegn.")]
        public string Wish { get; set; } = string.Empty;
    }
}

