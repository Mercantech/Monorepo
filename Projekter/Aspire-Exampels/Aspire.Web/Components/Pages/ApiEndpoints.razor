@page "/api-endpoints"
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 10)]
@rendermode InteractiveServer

@inject ApiClients.UserApiClient UserApi
@inject ApiClients.BookingApiClient BookingApi
@inject ILogger<ApiEndpoints> Logger

<PageTitle>API Endpoints & Redis Caching</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="display-4 mb-4">
                <i class="bi bi-server"></i> API Endpoints & Redis Caching
            </h1>
            <p class="lead">Oversigt over alle API endpoints med Redis caching performance metrics</p>
        </div>
    </div>

    <!-- Debug Status -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-bug"></i> Debug & Connection Status
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>API Endpoints</h6>
                            <ul class="list-unstyled">
                                <li><strong>User API:</strong> <code>/api/User</code></li>
                                <li><strong>Booking API:</strong> <code>/api/Booking</code></li>
                                <li><strong>Base URL:</strong> <code>https+http://apiservice</code></li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>Test Actions</h6>
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-info btn-sm" @onclick="TestConnection" disabled="@isLoading">
                                    <i class="bi bi-wifi"></i> Test Backend Connection
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="ShowDebugInfo">
                                    <i class="bi bi-info-circle"></i> Show Debug Info
                                </button>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(debugInfo))
                    {
                        <div class="mt-3">
                            <h6>Debug Information</h6>
                            <pre class="bg-dark text-light p-3 rounded"><code>@debugInfo</code></pre>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cache Status Overview -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-memory"></i> Redis Cache Status
                    </h5>
                </div>
                <div class="card-body">
                    @if (cacheStatus == null)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Henter cache status...</p>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        @if (cacheStatus.AllUsersCached)
                                        {
                                            <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle-fill text-danger fs-4"></i>
                                        }
                                    </div>
                                    <div>
                                        <h6 class="mb-1">Users Cache</h6>
                                        <span class="badge @(cacheStatus.AllUsersCached ? "bg-success" : "bg-danger")">
                                            @(cacheStatus.AllUsersCached ? "Cached" : "Not Cached")
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <button class="btn btn-outline-primary btn-sm" @onclick="RefreshCacheStatus">
                                    <i class="bi bi-arrow-clockwise"></i> Refresh Status
                                </button>
                                <button class="btn btn-outline-warning btn-sm ms-2" @onclick="ClearAllCaches">
                                    <i class="bi bi-trash"></i> Clear All Caches
                                </button>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-muted">@cacheStatus.Message</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- User API Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-people"></i> User API Endpoints
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="btn-group" role="group">
                                <button class="btn btn-outline-primary" @onclick="@(() => LoadUsers("normal"))" disabled="@isLoading">
                                    <i class="bi bi-download"></i> Load Users (Cache First)
                                </button>
                                <button class="btn btn-outline-info" @onclick="@(() => LoadUsers("database"))" disabled="@isLoading">
                                    <i class="bi bi-database"></i> From Database
                                </button>
                                <button class="btn btn-outline-warning" @onclick="@(() => LoadUsers("cache"))" disabled="@isLoading">
                                    <i class="bi bi-memory"></i> From Cache Only
                                </button>
                                <button class="btn btn-outline-success" @onclick="RunPerformanceTest" disabled="@isLoading">
                                    <i class="bi bi-speedometer2"></i> Performance Test
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="btn-group" role="group">
                                <button class="btn btn-outline-info btn-sm" @onclick="TestConnection" disabled="@isLoading">
                                    <i class="bi bi-wifi"></i> Test Connection
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => GenerateTestData(1000))" disabled="@isLoading">
                                    <i class="bi bi-plus-circle"></i> Generate 1K Users
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="ClearUserTestData" disabled="@isLoading">
                                    <i class="bi bi-trash"></i> Clear Test Data
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (userResponse != null)
                    {
                        <div class="alert alert-info">
                            <div class="row">
                                <div class="col-md-3">
                                    <strong>Source:</strong> @userResponse.Source
                                </div>
                                <div class="col-md-3">
                                    <strong>Count:</strong> @userResponse.UserCount
                                </div>
                                <div class="col-md-3">
                                    <strong>Time:</strong> @userResponse.ElapsedMilliseconds ms
                                </div>
                                <div class="col-md-3">
                                    @if (userResponse.Source.Contains("Cache"))
                                    {
                                        <span class="badge bg-success">Cached</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Database</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (userResponse.Users.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>Email</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in userResponse.Users.Take(10))
                                        {
                                            <tr>
                                                <td>@user.Id</td>
                                                <td>@user.Name</td>
                                                <td>@user.Email</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (userResponse.Users.Count() > 10)
                                {
                                    <div class="text-center mt-2">
                                        <small class="text-muted">Viser de første 10 af @userResponse.Users.Count() brugere</small>
                                    </div>
                                }
                            </div>
                        }
                    }

                    @if (performanceTest != null)
                    {
                        <div class="mt-4">
                            <h6>Performance Test Results</h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title">Database Performance</h6>
                                            <p class="card-text">
                                                <strong>Time:</strong> @GetPropertyValue(performanceTest.DatabaseTest, "elapsedMilliseconds") ms<br>
                                                <strong>Users:</strong> @GetPropertyValue(performanceTest.DatabaseTest, "userCount")<br>
                                                <strong>Avg/User:</strong> @GetPropertyValue(performanceTest.DatabaseTest, "averageTimePerUser") ms
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title">Cache Performance</h6>
                                            <p class="card-text">
                                                <strong>Time:</strong> @GetPropertyValue(performanceTest.CacheTest, "elapsedMilliseconds") ms<br>
                                                <strong>Users:</strong> @GetPropertyValue(performanceTest.CacheTest, "userCount")<br>
                                                <strong>Avg/User:</strong> @GetPropertyValue(performanceTest.CacheTest, "averageTimePerUser") ms
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Booking API Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar-check"></i> Booking API Endpoints
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="btn-group" role="group">
                                <button class="btn btn-outline-primary" @onclick="@(() => LoadBookings("normal"))" disabled="@isLoading">
                                    <i class="bi bi-download"></i> Load Bookings (Cache First)
                                </button>
                                <button class="btn btn-outline-info" @onclick="@(() => LoadBookings("database"))" disabled="@isLoading">
                                    <i class="bi bi-database"></i> From Database
                                </button>
                                <button class="btn btn-outline-warning" @onclick="@(() => LoadBookings("cache"))" disabled="@isLoading">
                                    <i class="bi bi-memory"></i> From Cache Only
                                </button>
                                <button class="btn btn-outline-success" @onclick="LoadComplexQuery" disabled="@isLoading">
                                    <i class="bi bi-diagram-3"></i> Complex Query
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="btn-group" role="group">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => GenerateBookingTestData(100, 10, 500))" disabled="@isLoading">
                                    <i class="bi bi-plus-circle"></i> Generate Test Data
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="ClearBookingTestData" disabled="@isLoading">
                                    <i class="bi bi-trash"></i> Clear Test Data
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (bookingResponse != null)
                    {
                        <div class="alert alert-info">
                            <div class="row">
                                <div class="col-md-3">
                                    <strong>Source:</strong> @bookingResponse.Source
                                </div>
                                <div class="col-md-3">
                                    <strong>Count:</strong> @bookingResponse.BookingCount
                                </div>
                                <div class="col-md-3">
                                    <strong>Time:</strong> @bookingResponse.ElapsedMilliseconds ms
                                </div>
                                <div class="col-md-3">
                                    @if (bookingResponse.Source.Contains("Cache"))
                                    {
                                        <span class="badge bg-success">Cached</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Database</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (bookingResponse.Bookings.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>ID</th>
                                            <th>Customer</th>
                                            <th>Stylist</th>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Price</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var booking in bookingResponse.Bookings.Take(10))
                                        {
                                            <tr>
                                                <td>@GetPropertyValue(booking, "Id")</td>
                                                <td>@GetPropertyValue(booking, "Customer")</td>
                                                <td>@GetPropertyValue(booking, "Stylist")</td>
                                                <td>@GetPropertyValue(booking, "BookingDate")</td>
                                                <td>@GetPropertyValue(booking, "StartTime")</td>
                                                <td>@GetPropertyValue(booking, "TotalPrice")</td>
                                                <td>@GetPropertyValue(booking, "Status")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (bookingResponse.Bookings.Count() > 10)
                                {
                                    <div class="text-center mt-2">
                                        <small class="text-muted">Viser de første 10 af @bookingResponse.Bookings.Count() bookinger</small>
                                    </div>
                                }
                            </div>
                        }
                    }

                    @if (complexQueryResponse != null)
                    {
                        <div class="mt-4">
                            <h6>Complex Query Results</h6>
                            <div class="alert alert-success">
                                <div class="row">
                                    <div class="col-md-4">
                                        <strong>Description:</strong> @complexQueryResponse.Description
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Results:</strong> @complexQueryResponse.ResultCount
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Time:</strong> @complexQueryResponse.ElapsedMilliseconds ms
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Indicator -->
    @if (isLoading)
    {
        <div class="position-fixed top-50 start-50 translate-middle">
            <div class="card">
                <div class="card-body text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 mb-0">@loadingMessage</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = false;
    private string loadingMessage = "";
    private string debugInfo = "";
    private ApiClients.UserApiResponse? userResponse;
    private ApiClients.BookingApiResponse? bookingResponse;
    private ApiClients.ComplexQueryResponse? complexQueryResponse;
    private ApiClients.PerformanceTestResponse? performanceTest;
    private ApiClients.CacheStatusResponse? cacheStatus;

    protected override async Task OnInitializedAsync()
    {
        await RefreshCacheStatus();
    }

    private async Task RefreshCacheStatus()
    {
        try
        {
            cacheStatus = await UserApi.GetCacheStatusAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fejl ved hentning af cache status");
        }
    }

    private async Task TestConnection()
    {
        Logger.LogInformation("🔌 TestConnection knap klikket!");
        Console.WriteLine("🔌 TestConnection knap klikket!");
        
        isLoading = true;
        loadingMessage = "Tester forbindelse til backend...";
        StateHasChanged();

        try
        {
            Logger.LogInformation("🚀 Starter forbindelsestest...");
            Console.WriteLine("🚀 Starter forbindelsestest...");
            
            // Test basic connectivity
            var testResponse = await UserApi.GetUsersAsync();
            
            if (testResponse != null)
            {
                Logger.LogInformation("✅ Forbindelsestest SUCCES! Backend er tilgængelig");
                Console.WriteLine("✅ Forbindelsestest SUCCES! Backend er tilgængelig");
                Logger.LogInformation("📊 Response details - Source: {Source}, Count: {Count}", testResponse.Source, testResponse.UserCount);
                Console.WriteLine($"📊 Response details - Source: {testResponse.Source}, Count: {testResponse.UserCount}");
            }
            else
            {
                Logger.LogWarning("⚠️ Forbindelsestest - Response er null");
                Console.WriteLine("⚠️ Forbindelsestest - Response er null");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Forbindelsestest FEJL: {Message}", ex.Message);
            Console.WriteLine($"❌ Forbindelsestest FEJL: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowDebugInfo()
    {
        Logger.LogInformation("🔍 ShowDebugInfo knap klikket!");
        Console.WriteLine("🔍 ShowDebugInfo knap klikket!");
        
        var userResponseInfo = userResponse != null ? 
            "- Source: " + userResponse.Source + "\n- UserCount: " + userResponse.UserCount + "\n- ElapsedMs: " + userResponse.ElapsedMilliseconds : 
            "No user response yet";
            
        var bookingResponseInfo = bookingResponse != null ? 
            "- Source: " + bookingResponse.Source + "\n- BookingCount: " + bookingResponse.BookingCount + "\n- ElapsedMs: " + bookingResponse.ElapsedMilliseconds : 
            "No booking response yet";
            
        var cacheStatusInfo = cacheStatus != null ? 
            "- AllUsersCached: " + cacheStatus.AllUsersCached + "\n- Message: " + cacheStatus.Message : 
            "No cache status yet";

        var userApiStatus = UserApi != null ? "✅ Injected" : "❌ Not Injected";
        var bookingApiStatus = BookingApi != null ? "✅ Injected" : "❌ Not Injected";
        var loggerStatus = Logger != null ? "✅ Injected" : "❌ Not Injected";
        var userResponseStatus = userResponse != null ? "✅ Set" : "❌ Null";
        var bookingResponseStatus = bookingResponse != null ? "✅ Set" : "❌ Null";
        var cacheStatusStatus = cacheStatus != null ? "✅ Set" : "❌ Null";

        var debug = "Debug Information - " + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + @"
===============================================

API Configuration:
- UserApiClient: " + userApiStatus + @"
- BookingApiClient: " + bookingApiStatus + @"
- Logger: " + loggerStatus + @"

Current State:
- isLoading: " + isLoading + @"
- loadingMessage: " + loadingMessage + @"
- userResponse: " + userResponseStatus + @"
- bookingResponse: " + bookingResponseStatus + @"
- cacheStatus: " + cacheStatusStatus + @"

Last User Response:
" + userResponseInfo + @"

Last Booking Response:
" + bookingResponseInfo + @"

Cache Status:
" + cacheStatusInfo;
        
        debugInfo = debug;
        Logger.LogInformation("🔍 Debug info generated and displayed");
        Console.WriteLine("🔍 Debug info generated and displayed");
        StateHasChanged();
    }

    private async Task LoadUsers(string source)
    {
        Logger.LogInformation("🖱️ LoadUsers knap klikket! Source: {Source}", source);
        Console.WriteLine($"🖱️ LoadUsers knap klikket! Source: {source}");
        
        isLoading = true;
        loadingMessage = $"Henter brugere fra {source}...";
        StateHasChanged();

        try
        {
            Logger.LogInformation("🚀 Starter LoadUsers med source: {Source}", source);
            Console.WriteLine($"🚀 Starter LoadUsers med source: {source}");
            
            userResponse = source switch
            {
                "normal" => await UserApi.GetUsersAsync(),
                "database" => await UserApi.GetUsersFromDatabaseAsync(),
                "cache" => await UserApi.GetUsersFromCacheAsync(),
                _ => throw new ArgumentException("Ugyldig source")
            };
            
            Logger.LogInformation("✅ LoadUsers completed! Response: {Response}", userResponse != null ? "Success" : "Null");
            Console.WriteLine($"✅ LoadUsers completed! Response: {(userResponse != null ? "Success" : "Null")}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Fejl ved hentning af brugere: {Message}", ex.Message);
            Console.WriteLine($"❌ Fejl ved hentning af brugere: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadBookings(string source)
    {
        Logger.LogInformation("🖱️ LoadBookings knap klikket! Source: {Source}", source);
        Console.WriteLine($"🖱️ LoadBookings knap klikket! Source: {source}");
        
        isLoading = true;
        loadingMessage = $"Henter bookinger fra {source}...";
        StateHasChanged();

        try
        {
            Logger.LogInformation("🚀 Starter LoadBookings med source: {Source}", source);
            Console.WriteLine($"🚀 Starter LoadBookings med source: {source}");
            
            bookingResponse = source switch
            {
                "normal" => await BookingApi.GetBookingsAsync(),
                "database" => await BookingApi.GetBookingsFromDatabaseAsync(),
                "cache" => await BookingApi.GetBookingsFromCacheAsync(),
                _ => throw new ArgumentException("Ugyldig source")
            };
            
            Logger.LogInformation("✅ LoadBookings completed! Response: {Response}", bookingResponse != null ? "Success" : "Null");
            Console.WriteLine($"✅ LoadBookings completed! Response: {(bookingResponse != null ? "Success" : "Null")}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Fejl ved hentning af bookinger: {Message}", ex.Message);
            Console.WriteLine($"❌ Fejl ved hentning af bookinger: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadComplexQuery()
    {
        isLoading = true;
        loadingMessage = "Kører kompleks query...";
        StateHasChanged();

        try
        {
            complexQueryResponse = await BookingApi.GetComplexQueryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fejl ved kompleks query");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RunPerformanceTest()
    {
        isLoading = true;
        loadingMessage = "Kører performance test...";
        StateHasChanged();

        try
        {
            performanceTest = await UserApi.GetPerformanceTestAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fejl ved performance test");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GenerateTestData(int count)
    {
        isLoading = true;
        loadingMessage = $"Genererer {count} test brugere...";
        StateHasChanged();

        try
        {
            var result = await UserApi.GenerateTestDataAsync(count);
            if (result != null)
            {
                Logger.LogInformation("Genererede {Count} test brugere på {Time}ms", result.Count, result.ElapsedMilliseconds);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fejl ved generering af test data");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GenerateBookingTestData(int customers, int stylists, int bookings)
    {
        isLoading = true;
        loadingMessage = $"Genererer test data: {customers} kunder, {stylists} stylister, {bookings} bookinger...";
        StateHasChanged();

        try
        {
            var result = await BookingApi.GenerateTestDataAsync(customers, stylists, bookings);
            if (result != null)
            {
                Logger.LogInformation("Genererede test data på {Time}ms", result.ElapsedMilliseconds);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fejl ved generering af booking test data");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearUserTestData()
    {
        isLoading = true;
        loadingMessage = "Rydder test data...";
        StateHasChanged();

        try
        {
            var result = await UserApi.ClearTestDataAsync();
            if (result != null)
            {
                Logger.LogInformation("Slettede {Count} test brugere", result.DeletedCount);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fejl ved rydning af test data");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearBookingTestData()
    {
        isLoading = true;
        loadingMessage = "Rydder booking test data...";
        StateHasChanged();

        try
        {
            var result = await BookingApi.ClearTestDataAsync();
            if (result != null)
            {
                Logger.LogInformation("Slettede booking test data");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fejl ved rydning af booking test data");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearAllCaches()
    {
        isLoading = true;
        loadingMessage = "Rydder alle caches...";
        StateHasChanged();

        try
        {
            await Task.WhenAll(
                UserApi.ClearCacheAsync(),
                BookingApi.ClearCacheAsync()
            );
            await RefreshCacheStatus();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fejl ved rydning af caches");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetPropertyValue(object obj, string propertyName)
    {
        try
        {
            var property = obj.GetType().GetProperty(propertyName);
            if (property != null)
            {
                var value = property.GetValue(obj);
                return value?.ToString() ?? "N/A";
            }
        }
        catch
        {
            // Ignore reflection errors
        }
        return "N/A";
    }
}